# Non-secret settings -> ConfigMap "app-config" (see kustomization.yaml).
# Kubernetes service names use dashes, so URLs differ from docker-compose.yml.
AUTH_SERVICE_URL=http://auth-service:8000
PRODUCT_SERVICE_URL=http://product-service:8000
ORDER_SERVICE_URL=http://order-service:8000
AUTH_MONGO_URL=mongodb://mongo:27017/auth_db
PRODUCT_MONGO_URL=mongodb://mongo:27017/product_db
ORDER_MONGO_URL=mongodb://mongo:27017/order_db
DISPATCHER_MONGO_URL=mongodb://mongo:27017/dispatcher_db
AUTH_BCRYPT_ROUNDS=10
