# Secret settings -> Secret "app-secrets" (see kustomization.yaml).
#
# DEV-ONLY PLACEHOLDER. This value exists only so the local kind cluster and
# CI can start. Never put a real secret in git: in a real environment the
# Secret would come from a secret manager (e.g. Azure Key Vault or GCP Secret
# Manager via External Secrets Operator) or from Sealed Secrets.
SECRET_KEY=dev-only-not-a-real-secret
